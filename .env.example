# ---------------------------------------------------------------------------
# Shared / infrastructure
# ---------------------------------------------------------------------------
NODE_ENV=development
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora
POSTGRES_DB=aurora_portfolio

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
DATABASE_URL=postgresql://aurora:aurora@localhost:5432/aurora_portfolio?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=120
CACHE_TTL=60

# Seeded owner account (change immediately after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Portfolio Owner

# Media storage — falls back to local disk when Cloudinary is not configured
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Server-to-server base URL (inside Docker: http://api:4000/api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1
# Browser-visible base URL used by the admin dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret
